# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_NAME="TaskFlow Core API"

# PostgreSQL Database
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=taskflow_db
DB_SYNCHRONIZE=true
DB_LOGGING=true

# Security & JWT
JWT_SECRET=super_secret_enterprise_jwt_key_taskflow_2026_change_in_production
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super_secret_refresh_token_key_taskflow_2026_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# Swagger Documentation
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs

